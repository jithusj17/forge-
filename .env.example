# Copy to .env.local for local development. Everything here is optional:
# without it Forge uses a local SQLite file, guest sign-in, and the free demo engine.

# Database (libSQL). Local file by default; use a Turso URL + token in production.
DATABASE_URL=file:./data/forge.db
DATABASE_AUTH_TOKEN=

# Auth (Better Auth). Generate a secret: npx auth@1.7.12 secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (optional). Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Claude (optional). Without a server key, visitors can paste their own key in Settings.
ANTHROPIC_API_KEY=
SERVER_KEY_DAILY_LIMIT=5
DAILY_GENERATION_LIMIT=50